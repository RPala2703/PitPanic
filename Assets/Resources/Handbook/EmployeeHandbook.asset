%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a10bc67374924fcdae07dd5b1b6afdd7, type: 3}
  m_Name: EmployeeHandbook
  m_EditorClassIdentifier: 
  entries:
  - id: staff-penguin
    category: 0
    title: 'Penguin'
    description: "Penguin accepted the position of pit boss after being assured it involved neither an actual pit nor a boss fight.\n\nHe has since discovered that managing a casino mostly involves walking quickly between problems while pretending to know which one is most urgent."
    image: {fileID: 21300000, guid: f30afa59c61164ad09f9205017506cdd, type: 3}
    unlock: 0
    level: 0
  - id: staff-tiger
    category: 0
    title: 'Tiger'
    description: "Tiger considers himself a natural leader, an exceptional dealer and the most handsome employee on the premises.\n\nHe also conducts the training shift, which he believes qualifies him to give advice on absolutely everything.\n\nHis colleagues have requested that he stop giving advice on absolutely everything."
    image: {fileID: 21300000, guid: 46593cc17775c4f60abafdcef629433c, type: 3}
    unlock: 0
    level: 0
  - id: staff-bear
    category: 0
    title: 'Bear'
    description: "Bear has memorised the entire employee handbook, including the footnotes, amendments and emergency procedures.\n\nHe occasionally quotes a regulation that doesn't appear in the current edition.\n\nManagement says he must be confusing it with the restaurant menu. Bear says the restaurant menu is much shorter."
    image: {fileID: 21300000, guid: 855ed35ad5b0b4f3d8e301a78db1dde8, type: 3}
    unlock: 0
    level: 0
  - id: staff-fox
    category: 0
    title: 'Fox'
    description: "Fox believes that every problem has a clever solution, preferably one that requires somebody else to do the work.\n\nHe's been banned from organising staff poker nights after winning seventeen consecutive games.\n\nFox insists this proves his natural talent. The other employees insist it proves something else."
    image: {fileID: 21300000, guid: a40209c4b35804521af0717ee626a73d, type: 3}
    unlock: 0
    level: 0
  - id: staff-pig
    category: 0
    title: 'Pig'
    description: "Pig knows precisely how much money he's earned, spent, saved and been unfairly denied.\n\nHe keeps his own ledger of the casino's finances, despite nobody asking him to.\n\nOne figure has been circled so many times that the paper is almost worn through. Pig calls it an accounting disagreement."
    image: {fileID: 21300000, guid: df0656aac79d242ea805f0edd2160521, type: 3}
    unlock: 0
    level: 0
  - id: guest-rabbit
    category: 1
    title: 'Rabbit'
    description: "Rabbit firmly believes in lucky numbers.\n\nUnfortunately, those numbers change after every losing bet. Rabbit calls this a sophisticated mathematical strategy.\n\nThe casino calls it a reliable source of income."
    image: {fileID: 21300000, guid: 8d29bbd77b4c74215af82278041d702e, type: 3}
    unlock: 1
    level: 0
  - id: guest-dog
    category: 1
    title: 'Dog'
    description: "Dog visits the casino primarily to make friends.\n\nHe greets every dealer like a long-lost relative and considers every winning hand a team achievement.\n\nHe has twice been asked to stop congratulating the Roulette wheel."
    image: {fileID: 21300000, guid: cb06592008b324a219c4505025624543, type: 3}
    unlock: 1
    level: 0
  - id: guest-cat
    category: 1
    title: 'Cat'
    description: "Cat claims to have absolutely no interest in gambling.\n\nShe visits purely for the comfortable chairs, pleasant atmosphere and complimentary refreshments.\n\nShe also knows the exact payout of every Blackjack hand, but considers this entirely coincidental."
    image: {fileID: 21300000, guid: 6a35ec63af64948709ee5f2d1f82f917, type: 3}
    unlock: 1
    level: 0
  - id: guest-raccoon
    category: 1
    title: 'Raccoon'
    description: "Raccoon has never been caught stealing anything from the casino.\n\nHe has, however, been politely informed that the complimentary mints, napkins and drinks coasters are intended for use on the premises.\n\nHe considers this an unreasonable restriction."
    image: {fileID: 21300000, guid: 5a37edabd55754eb489d18d4d73d20b3, type: 3}
    unlock: 1
    level: 0
  - id: guest-deer
    category: 1
    title: 'Deer'
    description: "Deer apologises before placing a bet, after losing a bet and occasionally to the dealer for winning.\n\nHe once attempted to tip a Roulette wheel for its excellent service.\n\nThe casino accepted the money."
    image: {fileID: 21300000, guid: 3d6fb97f22b504077a2908e615fd3642, type: 3}
    unlock: 1
    level: 0
  - id: guest-elephant
    category: 1
    title: 'Elephant'
    description: "Elephant never forgets a winning streak, a losing streak or an occasion when the dealer accidentally short-changed her.\n\nShe does, however, regularly forget where she parked.\n\nManagement has suggested that she start remembering less important things."
    image: {fileID: 21300000, guid: 4a53b19fe18f44115a30f9181f219629, type: 3}
    unlock: 1
    level: 0
  - id: guest-vip
    category: 1
    title: 'VIP Guests'
    description: "VIP guests wear expensive clothes, place larger bets and expect to be served before they've finished asking.\n\nMany claim to have exceptionally good luck.\n\nManagement would like to remind guests that purchasing a gold suit does not improve the probability of winning."
    image: {fileID: 21300000, guid: 4b8d3fd53443b4268b0460d9f9f73955, type: 3}
    unlock: 2
    level: 2
  - id: equipment-blackjack
    category: 2
    title: 'Blackjack Table'
    description: "The Blackjack table is where customers attempt to reach 21 without going over, and dealers attempt to maintain their composure.\n\nThe felt is cleaned daily.\n\nThe complaints are filed weekly."
    image: {fileID: 21300000, guid: c8af9a0a525084335a6af182ed2dbb25, type: 3}
    unlock: 1
    level: 0
  - id: equipment-roulette
    category: 2
    title: 'Roulette Table'
    description: "A spinning wheel, a bouncing ball and a room full of customers convinced they know exactly where it will land.\n\nThe Roulette wheel has never offered financial advice.\n\nThis has not stopped anyone from taking it."
    image: {fileID: 21300000, guid: 5f5596657b0124aa18f327311d390173, type: 3}
    unlock: 1
    level: 0
  - id: equipment-cash-desk
    category: 2
    title: 'Cash Desk'
    description: "The Cash Desk is responsible for keeping money and casino chips moving in the correct directions.\n\nAll transactions should be counted carefully.\n\nPig has volunteered to supervise this process approximately forty times. His application remains under consideration."
    image: {fileID: 21300000, guid: e47c1575d78e1475fb4138a32b8e2567, type: 3}
    unlock: 1
    level: 0
  - id: equipment-pit-desk
    category: 2
    title: 'Pit Desk'
    description: "The Pit Desk is the centre of casino operations, where important decisions are made and security footage is reviewed.\n\nIt was originally described in the employee handbook as a place of calm leadership.\n\nSomeone has crossed out the word \"calm.\""
    image: {fileID: 21300000, guid: e7b32108aa31f4150af811ce2c0bf0fc, type: 3}
    unlock: 1
    level: 0
  - id: equipment-velvet-chair
    category: 2
    title: 'Velvet Chair'
    description: "Casino chairs are designed to provide maximum comfort during extended periods of sitting, waiting and questioning your financial decisions.\n\nManagement selected velvet for its elegance.\n\nThe cleaning staff were not consulted."
    image: {fileID: 21300000, guid: c3687923017cf4d2caa82f471b1976e9, type: 3}
    unlock: 1
    level: 0
  - id: equipment-lucky-seven
    category: 2
    title: 'Lucky Seven Chip'
    description: "The Lucky Seven was introduced as part of a short-lived promotional campaign.\n\nSeveral customers insisted the chips brought them extraordinary good fortune. Management attributed this to effective marketing.\n\nThe entire batch was recalled following a manufacturing irregularity.\n\nRequests for replacement chips are still received occasionally."
    image: {fileID: 0}
    useCasinoChipArt: 1
    unlock: 3
    level: 2
  - id: rules-passing-a-shift
    category: 3
    title: 'Passing a Shift'
    description: "To pass a shift, complete at least 4 tasks, maintain guest satisfaction of 60% or higher, and miss no more than 5 tasks.\n\nManagement considers these expectations perfectly reasonable.\n\nManagement is not currently accepting feedback."
    image: {fileID: 21300000, guid: 0d6d482901dba467b94d813489b4fc1c, type: 3}
    unlock: 1
    level: 0
  - id: rules-star-ratings
    category: 3
    title: 'Star Ratings'
    description: "Your shift rating reflects how satisfied your guests were and how many tasks you missed.\n\nTips provide a small additional bonus.\n\nThree stars indicate an excellent performance. One star indicates Management would like a word."
    image: {fileID: 21300000, guid: 994031218b32d4a3ba9cf6305dbae16b, type: 3}
    unlock: 3
    level: 1
  - id: rules-vip-service
    category: 3
    title: 'VIP Service'
    description: "VIP guests place larger bets, have less patience and expect particularly attentive service.\n\nPrioritise their requests when necessary.\n\nUnder no circumstances should you tell a VIP that their expensive outfit has no effect on the Roulette wheel.\n\nEven when it's true."
    image: {fileID: 21300000, guid: 6f58293ef10734228a5eccd09a155ee8, type: 3}
    unlock: 2
    level: 2
  - id: rules-footage-review
    category: 3
    title: 'Footage Review'
    description: "When suspicious activity is reported, review the footage at the Pit Desk and watch the hand and chip carefully.\n\nChoose CHEATING if the evidence shows improper chip movement. Otherwise, choose CLEAR.\n\nGuessing is not an approved security procedure, regardless of what Fox says."
    image: {fileID: 21300000, guid: e7b32108aa31f4150af811ce2c0bf0fc, type: 3}
    unlock: 2
    level: 3
  - id: archive-trial-12
    category: 4
    title: 'Trial 12 — Follow-Up'
    description: "Sample 07-B: Secured\nRecipient: Released\nSource: No follow-up scheduled\n\n[Handwritten note]\n\n\"He came back asking for it.\"\n\n[Reply — different handwriting]\n\n\"How does he know we took anything?\""
    image: {fileID: 21300000, guid: e7b32108aa31f4150af811ce2c0bf0fc, type: 3}
    unlock: 3
    level: 3
